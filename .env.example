# Database Configuration (PostgreSQL / SQLite fallback)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=warroom
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/warroom

# JWT & Authentication
JWT_SECRET=super-secret-war-room-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=7

# LLM Configuration (OpenAI, Gemini, or compatible endpoint)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
